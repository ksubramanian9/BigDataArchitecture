        "mean": 4.5,
        "stddev": 1.2
      },
      {
        "name": "queue_length_vehicles",
        "type": "int",
        "min": 0,
        "max": 150,
        "skew": 1.7
      },
      {
        "name": "travel_time_index",
        "type": "float",
        "distribution": "lognormal",
        "mean": 0.2,
        "stddev": 0.35
      },
      {
        "name": "geo",
        "type": "geo",
        "bbox": [
          12.8,
          77.45,
          13.1,
          77.8
