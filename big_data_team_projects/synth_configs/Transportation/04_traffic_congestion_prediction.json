{
  "seed": 46,
  "entity_count": 200000,
  "time_window": {
    "start": "2025-01-01T00:00:00",
    "end": "2025-03-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "event_id",
        "type": "uuid"
      },
      {
        "name": "event_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "7": 1.6,
            "8": 1.8,
            "9": 1.4,
            "17": 1.7,
            "18": 1.8,
            "19": 1.4,
            "_default": 0.7
          },
          "day_of_week": {
            "0": 0.7,
            "6": 0.8,
            "_default": 1.0
          }
        }
      },
      {
        "name": "city",
        "type": "category",
        "choices": [
          {
            "value": "Bengaluru",
            "weight": 3
          },
          {
            "value": "Chennai",
            "weight": 2
          },
          {
            "value": "Mumbai",
            "weight": 3
          },
          {
            "value": "Delhi",
            "weight": 3
          },
          {
            "value": "Hyderabad",
            "weight": 1
          }
        ]
      },
      {
        "name": "road_segment_id",
        "type": "string",
        "pattern": "SEG{0000-9999}"
      },
      {
        "name": "corridor_type",
        "type": "category",
        "choices": [
          "Arterial",
          "Highway",
          "Feeder",
          "Ring_Road",
          "CBD_Street"
        ]
      },
      {
        "name": "sensor_type",
        "type": "category",
        "choices": [
          "Loop",
          "Camera",
          "GPS",
          "Bluetooth",
          "Crowdsourced"
        ]
      },
      {
        "name": "avg_speed_kmph",
        "type": "float",
        "distribution": "normal",
        "mean": 34,
        "stddev": 12
      },
      {
        "name": "free_flow_speed_kmph",
        "type": "float",
        "distribution": "normal",
        "mean": 52,
        "stddev": 10
      },
      {
        "name": "travel_time_minutes",
        "type": "float",
        "distribution": "lognormal",
        "mean": 0.9,
        "stddev": 0.6
      },
      {
        "name": "vehicle_count",
        "type": "int",
        "min": 10,
        "max": 4000,
        "skew": 1.3
      },
      {
        "name": "lane_occupancy_pct",
        "type": "float",
        "distribution": "normal",
        "mean": 58,
        "stddev": 20
      },
      {
        "name": "congestion_level",
        "type": "category",
        "choices": [
          {
            "value": "Free_Flow",
            "weight": 2
          },
          {
            "value": "Moderate",
            "weight": 5
          },
          {
            "value": "Heavy",
            "weight": 3
          }
        ]
      },
      {
        "name": "incident_flag",
        "type": "bool",
        "p_true": 0.12
      },
      {
        "name": "incident_category",
        "type": "category",
        "choices": [
          "Accident",
          "Breakdown",
          "Roadwork",
          "Event",
          "Weather",
          "None"
        ]
      },
      {
        "name": "weather_condition",
        "type": "category",
        "choices": [
          {
            "value": "Clear",
            "weight": 5
