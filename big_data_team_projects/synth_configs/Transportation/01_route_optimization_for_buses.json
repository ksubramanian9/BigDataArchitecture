{
  "seed": 43,
  "entity_count": 200000,
  "time_window": {
    "start": "2025-01-01T06:00:00",
    "end": "2025-02-28T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "event_id",
        "type": "uuid"
      },
      {
        "name": "event_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "6": 1.2,
            "7": 1.5,
            "8": 1.6,
            "9": 1.4,
            "17": 1.4,
            "18": 1.6,
            "19": 1.5,
            "_default": 0.9
          },
          "day_of_week": {
            "0": 0.8,
            "6": 0.85,
            "_default": 1.0
          }
        }
      },
      {
        "name": "city",
        "type": "category",
        "choices": [
          {
            "value": "Bengaluru",
            "weight": 3
          },
          {
            "value": "Chennai",
            "weight": 2
          },
          {
            "value": "Mumbai",
            "weight": 2
          },
          {
            "value": "Delhi",
            "weight": 2
          },
          {
            "value": "Hyderabad",
            "weight": 1
          }
        ]
      },
      {
        "name": "depot_id",
        "type": "category",
        "conditional_on": "city",
        "conditional_table": {
          "Bengaluru": [
            "DEP_MAJ",
            "DEP_SWD",
            "DEP_KRM"
          ],
          "Chennai": [
            "DEP_CMBT",
            "DEP_TMB",
            "DEP_VLC"
          ],
          "Mumbai": [
            "DEP_AND",
            "DEP_DAD",
            "DEP_BND"
          ],
          "Delhi": [
            "DEP_RKA",
            "DEP_SJP",
            "DEP_DWL"
          ],
          "Hyderabad": [
            "DEP_AMR",
            "DEP_LBN",
            "DEP_HIT"
          ],
          "_default": [
            "DEP_MAIN"
          ]
        }
      },
      {
        "name": "route_id",
        "type": "string",
        "pattern": "B{000-999}"
      },
      {
        "name": "trip_id",
        "type": "string",
        "pattern": "TRIP{000000-999999}"
      },
      {
        "name": "direction",
        "type": "category",
        "choices": [
          "Outbound",
          "Inbound"
        ]
      },
      {
        "name": "segment_index",
        "type": "int",
        "min": 1,
        "max": 40,
        "skew": 1.1
      },
      {
        "name": "segment_distance_km",
        "type": "float",
        "distribution": "lognormal",
        "mean": 0.35,
        "stddev": 0.45
      },
      {
        "name": "scheduled_run_minutes",
        "type": "int",
        "min": 2,
        "max": 25,
        "skew": 1.2
      },
      {
        "name": "actual_run_minutes",
        "type": "int",
        "min": 2,
        "max": 35,
        "skew": 1.4
      },
      {
        "name": "scheduled_headway_minutes",
        "type": "int",
        "min": 5,
        "max": 20,
        "skew": 1.3
      },
      {
        "name": "actual_headway_minutes",
        "type": "int",
        "min": 4,
        "max": 30,
        "skew": 1.5
      },
      {
        "name": "passenger_count",
        "type": "int",
        "min": 5,
        "max": 120,
        "skew": 1.6
      },
      {
        "name": "occupancy_rate_pct",
        "type": "float",
        "distribution": "normal",
        "mean": 68,
        "stddev": 18
      },
      {
        "name": "dwell_time_seconds",
        "type": "int",
        "min": 10,
        "max": 180,
        "skew": 1.4
      },
      {
        "name": "fuel_consumed_liters",
        "type": "float",
        "distribution": "lognormal",
        "mean": 0.2,
        "stddev": 0.35
      },
      {
        "name": "gps_variance_m",
        "type": "float",
        "distribution": "lognormal",
        "mean": -1.0,
        "stddev": 0.6
      },
      {
        "name": "on_time_performance",
        "type": "category",
        "choices": [
          {
            "value": "Early",
            "weight": 1
          },
          {
            "value": "On_Time",
            "weight": 6
          },
          {
            "value": "Late",
            "weight": 3
          }
        ]
      },
      {
        "name": "geo",
        "type": "geo",
        "bbox": [
          12.8,
          77.45,
          13.1,
          77.8
        ],
        "as_object": true
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "route_id",
          "trip_id",
          "segment_index"
        ],
        "sep": "|"
      }
    ]
  }
}
