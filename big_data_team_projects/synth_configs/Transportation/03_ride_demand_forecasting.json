{
  "seed": 45,
  "entity_count": 200000,
  "time_window": {
    "start": "2025-01-01T00:00:00",
    "end": "2025-03-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "event_id",
        "type": "uuid"
      },
      {
        "name": "event_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "6": 1.1,
            "7": 1.3,
            "8": 1.6,
            "9": 1.5,
            "17": 1.4,
            "18": 1.7,
            "19": 1.6,
            "22": 1.2,
            "_default": 0.8
          },
          "day_of_week": {
            "5": 0.95,
            "6": 1.05,
            "_default": 1.0
          }
        }
      },
      {
        "name": "city",
        "type": "category",
        "choices": [
          {
            "value": "Bengaluru",
            "weight": 3
          },
          {
            "value": "Chennai",
            "weight": 2
          },
          {
            "value": "Mumbai",
            "weight": 3
          },
          {
            "value": "Delhi",
            "weight": 2
          },
          {
            "value": "Hyderabad",
            "weight": 1
          }
        ]
      },
      {
        "name": "service_zone",
        "type": "category",
        "choices": [
          "CBD",
          "Airport",
          "Residential",
          "Business_Park",
          "Tourist_District"
        ]
      },
      {
        "name": "platform",
        "type": "category",
        "choices": [
          "RideShare",
          "BikeTaxi",
          "Auto",
          "Shuttle"
        ]
      },
      {
        "name": "hourly_requests",
        "type": "int",
        "min": 5,
        "max": 1200,
        "skew": 1.5
      },
      {
        "name": "fulfilled_rides",
        "type": "int",
        "min": 0,
        "max": 1100,
        "skew": 1.4
      },
      {
        "name": "cancelled_requests",
        "type": "int",
        "min": 0,
        "max": 300,
        "skew": 1.5
      },
      {
        "name": "avg_wait_time_minutes",
        "type": "int",
        "min": 1,
        "max": 25,
        "skew": 1.6
      },
      {
        "name": "available_drivers",
        "type": "int",
        "min": 5,
        "max": 800,
        "skew": 1.4
      },
      {
        "name": "surge_multiplier",
        "type": "float",
        "distribution": "lognormal",
        "mean": -0.05,
        "stddev": 0.35
      },
      {
        "name": "average_trip_distance_km",
        "type": "float",
        "distribution": "lognormal",
        "mean": 0.45,
        "stddev": 0.5
      },
      {
        "name": "weather_condition",
        "type": "category",
        "choices": [
          {
            "value": "Clear",
            "weight": 5
          },
          {
            "value": "Cloudy",
            "weight": 3
          },
          {
            "value": "Rain",
            "weight": 2
          },
          {
            "value": "Thunderstorm",
            "weight": 1
          }
        ]
      },
      {
        "name": "temperature_c",
        "type": "float",
        "distribution": "normal",
        "mean": 28,
        "stddev": 4
      },
      {
        "name": "major_event_flag",
        "type": "bool",
        "p_true": 0.08
      },
      {
        "name": "marketing_promo_active",
        "type": "bool",
        "p_true": 0.15
      },
      {
        "name": "geo",
        "type": "geo",
        "bbox": [
          12.8,
          77.45,
          13.1,
          77.8
        ],
        "as_object": true
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "city",
          "service_zone",
          "platform",
          "event_time"
        ],
        "sep": "|"
      }
    ]
  }
}
