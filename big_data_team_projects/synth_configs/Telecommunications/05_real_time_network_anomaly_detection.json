{
  "seed": 47,
  "entity_count": 220000,
  "time_window": {
    "start": "2025-01-01T06:00:00",
    "end": "2025-02-28T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      { "name": "event_id", "type": "uuid" },
      {
        "name": "event_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "0": 1.1,
            "9": 1.3,
            "18": 1.4,
            "21": 1.3,
            "_default": 0.9
          },
          "day_of_week": {
            "5": 1.1,
            "6": 1.2,
            "_default": 1.0
          }
        }
      },
      {
        "name": "city",
        "type": "category",
        "choices": [
          { "value": "Bengaluru", "weight": 3 },
          { "value": "Chennai", "weight": 2 },
          { "value": "Mumbai", "weight": 2 },
          { "value": "Delhi", "weight": 2 },
          { "value": "Hyderabad", "weight": 1 }
        ]
      },
      {
        "name": "cell_id",
        "type": "string",
        "pattern": "CELL-{00000-99999}"
      },
      {
        "name": "sector_id",
        "type": "category",
        "choices": [
          { "value": "A", "weight": 1 },
          { "value": "B", "weight": 1 },
          { "value": "C", "weight": 1 }
        ]
      },
      {
        "name": "technology",
        "type": "category",
        "choices": [
          { "value": "4G", "weight": 4 },
          { "value": "5G", "weight": 6 }
        ]
      },
      {
        "name": "traffic_load_erlang",
        "type": "float",
        "distribution": "lognormal",
        "mean": 2.0,
        "stddev": 0.7
      },
      {
        "name": "downlink_throughput_mbps",
        "type": "float",
        "distribution": "normal",
        "mean": 85,
        "stddev": 40
      },
      {
        "name": "uplink_throughput_mbps",
        "type": "float",
        "distribution": "normal",
        "mean": 18,
        "stddev": 8
      },
      {
        "name": "latency_ms",
        "type": "float",
        "distribution": "normal",
        "mean": 22,
        "stddev": 9
      },
      {
        "name": "packet_loss_pct",
        "type": "float",
        "distribution": "beta",
        "alpha": 1.2,
        "beta": 20
      },
      {
        "name": "jitter_ms",
        "type": "float",
        "distribution": "normal",
        "mean": 8,
        "stddev": 4
      },
      {
        "name": "rf_noise_dbm",
        "type": "float",
        "distribution": "normal",
        "mean": -102,
        "stddev": 6
      },
      {
        "name": "alarm_type",
        "type": "category",
        "choices": [
          { "value": "None", "weight": 82 },
          { "value": "High Latency", "weight": 5 },
          { "value": "Packet Loss", "weight": 4 },
          { "value": "Throughput Dip", "weight": 5 },
          { "value": "RF Interference", "weight": 4 }
        ]
      },
      {
        "name": "alarm_severity",
        "type": "category",
        "choices": [
          { "value": "None", "weight": 80 },
          { "value": "Minor", "weight": 10 },
          { "value": "Major", "weight": 6 },
          { "value": "Critical", "weight": 4 }
        ]
      },
      {
        "name": "anomaly_score",
        "type": "float",
        "distribution": "beta",
        "alpha": 2.0,
        "beta": 3.5
      },
      {
        "name": "anomaly_flag",
        "type": "bool",
        "p_true": 0.08
      },
      {
        "name": "remediation_action",
        "type": "category",
        "choices": [
          { "value": "None", "weight": 70 },
          { "value": "Automated Rebalance", "weight": 12 },
          { "value": "Engineer Dispatch", "weight": 8 },
          { "value": "Carrier Aggregation Tuning", "weight": 6 },
          { "value": "Spectrum Scan", "weight": 4 }
        ]
      },
      {
        "name": "customer_impact_estimate",
        "type": "int",
        "min": 0,
        "max": 2000,
        "skew": 1.4
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "cell_id",
          "sector_id",
          "technology"
        ],
        "sep": "|"
      }
    ]
  }
}
