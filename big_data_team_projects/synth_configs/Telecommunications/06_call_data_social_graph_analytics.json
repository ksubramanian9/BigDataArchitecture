{
  "seed": 48,
  "entity_count": 250000,
  "time_window": {
    "start": "2025-01-01T00:00:00",
    "end": "2025-02-28T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      { "name": "call_id", "type": "uuid" },
      {
        "name": "call_start_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "8": 1.3,
            "9": 1.4,
            "12": 1.4,
            "18": 1.6,
            "21": 1.5,
            "_default": 0.8
          },
          "day_of_week": {
            "5": 0.9,
            "6": 1.2,
            "_default": 1.0
          }
        }
      },
      {
        "name": "caller_id",
        "type": "string",
        "pattern": "MSISDN-{6000000000-9999999999}"
      },
      {
        "name": "callee_id",
        "type": "string",
        "pattern": "MSISDN-{6000000000-9999999999}"
      },
      {
        "name": "call_direction",
        "type": "category",
        "choices": [
          { "value": "Outbound", "weight": 5 },
          { "value": "Inbound", "weight": 4 },
          { "value": "Missed", "weight": 1 }
        ]
      },
      {
        "name": "call_type",
        "type": "category",
        "choices": [
          { "value": "Voice", "weight": 7 },
          { "value": "Video", "weight": 2 },
          { "value": "Conference", "weight": 1 }
        ]
      },
      {
        "name": "call_duration_sec",
        "type": "int",
        "min": 0,
        "max": 7200,
        "skew": 1.6
      },
      {
        "name": "call_result",
        "type": "category",
        "choices": [
          { "value": "Completed", "weight": 82 },
          { "value": "Dropped", "weight": 6 },
          { "value": "Busy", "weight": 4 },
          { "value": "No Answer", "weight": 8 }
        ]
      },
      {
        "name": "tower_id",
        "type": "string",
        "pattern": "TWR-{00000-99999}"
      },
      {
        "name": "tower_geo",
        "type": "geo",
        "bbox": [
          12.8,
          77.0,
          13.3,
          77.9
        ],
        "as_object": true
      },
      {
        "name": "roaming_flag",
        "type": "bool",
        "p_true": 0.12
      },
      {
        "name": "sms_count_7d",
        "type": "int",
        "min": 0,
        "max": 120,
        "skew": 1.9
      },
      {
        "name": "data_sessions_7d",
        "type": "int",
        "min": 0,
        "max": 300,
        "skew": 1.5
      },
      {
        "name": "total_interactions_30d",
        "type": "int",
        "min": 1,
        "max": 400,
        "skew": 1.1
      },
      {
        "name": "relationship_strength_score",
        "type": "float",
        "distribution": "beta",
        "alpha": 2.8,
        "beta": 2.2
      },
      {
        "name": "community_id",
        "type": "string",
        "pattern": "COMM-{000-999}"
      },
      {
        "name": "shared_contacts_count",
        "type": "int",
        "min": 0,
        "max": 80,
        "skew": 1.4
      },
      {
        "name": "average_gap_between_calls_min",
        "type": "float",
        "distribution": "lognormal",
        "mean": 3.5,
        "stddev": 0.8
      },
      {
        "name": "weekend_interaction_ratio",
        "type": "float",
        "distribution": "beta",
        "alpha": 3.0,
        "beta": 3.0
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "caller_id",
          "callee_id"
        ],
        "sep": "|"
      }
    ]
  }
}
