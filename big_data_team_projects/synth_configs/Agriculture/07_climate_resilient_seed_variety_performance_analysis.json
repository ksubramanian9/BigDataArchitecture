{
  "seed": 707,
  "entity_count": 130000,
  "time_window": {
    "start": "2024-07-01T00:00:00",
    "end": "2025-03-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "trial_record_id",
        "type": "uuid"
      },
      {
        "name": "observation_date",
        "type": "datetime",
        "format": "%Y-%m-%d"
      },
      {
        "name": "state",
        "type": "category",
        "choices": ["Karnataka", "Tamil Nadu", "Maharashtra", "Odisha", "Bihar"]
      },
      {
        "name": "district",
        "type": "category",
        "conditional_on": "state",
        "conditional_table": {
          "Karnataka": ["Hassan", "Davanagere", "Gadag"],
          "Tamil Nadu": ["Tiruchirapalli", "Cuddalore", "Theni"],
          "Maharashtra": ["Parbhani", "Jalgaon", "Wardha"],
          "Odisha": ["Cuttack", "Sambalpur", "Balasore"],
          "Bihar": ["Darbhanga", "Purnea", "Nalanda"],
          "_default": ["TrialDistrict"]
        }
      },
      {
        "name": "agro_climatic_zone",
        "type": "derived_map",
        "from_field": "state",
        "map": {
          "Karnataka": "Southern Plateau",
          "Tamil Nadu": "East Coast Plains",
          "Maharashtra": "Western Plateau",
          "Odisha": "Eastern Ghat",
          "Bihar": "Middle Gangetic"
        },
        "default": "Unknown"
      },
      {
        "name": "seed_variety",
        "type": "category",
        "choices": ["Var-A1", "Var-B3", "Var-C5", "Var-D2", "Var-E4"]
      },
      {
        "name": "crop",
        "type": "category",
        "choices": ["Rice", "Wheat", "Millet", "Pulses"]
      },
      {
        "name": "replication_plot",
        "type": "string",
        "pattern": "REP-{00-99}"
      },
      {
        "name": "soil_type",
        "type": "category",
        "choices": ["loamy", "clay", "sandy_loam", "black_cotton"]
      },
      {
        "name": "rainfall_mm",
        "type": "float",
        "distribution": "normal",
        "mean": 1120.0,
        "stddev": 260.0
      },
      {
        "name": "avg_temp_c",
        "type": "float",
        "distribution": "normal",
        "mean": 30.0,
        "stddev": 3.5
      },
      {
        "name": "heatwave_days",
        "type": "int",
        "min": 0,
        "max": 25,
        "skew": 1.3
      },
      {
        "name": "drought_stress_flag",
        "type": "bool",
        "p_true": 0.28
      },
      {
        "name": "disease_incidence_pct",
        "type": "float",
        "distribution": "uniform",
        "min": 0.0,
        "max": 35.0
      },
      {
        "name": "yield_kg_per_ha",
        "type": "float",
        "distribution": "normal",
        "mean": 5100.0,
        "stddev": 880.0
      },
      {
        "name": "resilience_score",
        "type": "float",
        "distribution": "uniform",
        "min": 0.4,
        "max": 0.95
      },
      {
        "name": "recommended_action",
        "type": "derived_map",
        "from_field": "seed_variety",
        "map": {
          "Var-A1": "scale", 
          "Var-B3": "promote",
          "Var-C5": "monitor",
          "Var-D2": "monitor",
          "Var-E4": "pilot"
        },
        "default": "monitor"
      },
      {
        "name": "trial_key",
        "type": "derived_concat",
        "parts": ["seed_variety", "state", "district", "replication_plot"],
        "sep": "|"
      }
    ]
  }
}
