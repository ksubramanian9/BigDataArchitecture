{
  "seed": 503,
  "entity_count": 120000,
  "time_window": {
    "start": "2024-04-01T00:00:00",
    "end": "2025-03-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "record_id",
        "type": "uuid"
      },
      {
        "name": "trade_date",
        "type": "datetime",
        "format": "%Y-%m-%d"
      },
      {
        "name": "state",
        "type": "category",
        "choices": ["Karnataka", "Tamil Nadu", "Maharashtra", "Punjab", "Gujarat"]
      },
      {
        "name": "market_name",
        "type": "category",
        "conditional_on": "state",
        "conditional_table": {
          "Karnataka": ["Bengaluru_APMC", "Hubballi_APMC", "Mysuru_Market"],
          "Tamil Nadu": ["Chennai_Koyambedu", "Madurai_Matuthavani", "Coimbatore_APMC"],
          "Maharashtra": ["Mumbai_Vashi", "Pune_Marketyard", "Nagpur_Kalamna"],
          "Punjab": ["Amritsar_Kaler", "Ludhiana_Grain", "Jalandhar_New"],
          "Gujarat": ["Ahmedabad_Jamnadas", "Rajkot_Jilla", "Surat_Yard"],
          "_default": ["Reference_Market"]
        }
      },
      {
        "name": "crop",
        "type": "category",
        "choices": ["Rice", "Wheat", "Maize", "Tur", "Soybean", "Cotton"]
      },
      {
        "name": "crop_grade",
        "type": "category",
        "choices": ["FAQ", "A-Grade", "B-Grade", "Organic"]
      },
      {
        "name": "market_type",
        "type": "category",
        "choices": ["APMC", "Cooperative", "Private", "Terminal"]
      },
      {
        "name": "arrival_tonnes",
        "type": "float",
        "distribution": "lognormal",
        "mean": 2.4,
        "stddev": 0.45
      },
      {
        "name": "min_price_inr_per_qtl",
        "type": "float",
        "distribution": "normal",
        "mean": 1450.0,
        "stddev": 320.0
      },
      {
        "name": "max_price_inr_per_qtl",
        "type": "float",
        "distribution": "normal",
        "mean": 1850.0,
        "stddev": 360.0
      },
      {
        "name": "modal_price_inr_per_qtl",
        "type": "float",
        "distribution": "normal",
        "mean": 1650.0,
        "stddev": 280.0
      },
      {
        "name": "price_volatility_index",
        "type": "float",
        "distribution": "uniform",
        "min": 0.5,
        "max": 8.0
      },
      {
        "name": "arrival_volatility_index",
        "type": "float",
        "distribution": "uniform",
        "min": 0.2,
        "max": 6.0
      },
      {
        "name": "arrivals_trend_flag",
        "type": "bool",
        "p_true": 0.35
      },
      {
        "name": "price_trend_flag",
        "type": "bool",
        "p_true": 0.4
      },
      {
        "name": "season",
        "type": "category",
        "choices": [
          { "value": "Kharif", "weight": 4 },
          { "value": "Rabi", "weight": 3 },
          { "value": "Summer", "weight": 2 }
        ]
      },
      {
        "name": "record_key",
        "type": "derived_concat",
        "parts": ["trade_date", "market_name", "crop", "crop_grade"],
        "sep": "|"
      }
    ]
  }
}
