{
  "seed": 564,
  "entity_count": 160000,
  "time_window": {
    "start": "2025-02-01T00:00:00",
    "end": "2025-04-30T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "detection_id",
        "type": "uuid"
      },
      {
        "name": "detection_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "6": 1.4,
            "7": 1.6,
            "8": 1.3,
            "16": 1.2,
            "_default": 0.9
          },
          "day_of_week": {
            "5": 0.8,
            "6": 0.75,
            "_default": 1.0
          }
        }
      },
      {
        "name": "farm_id",
        "type": "string",
        "pattern": "FARM-{0000-9999}"
      },
      {
        "name": "block_id",
        "type": "string",
        "pattern": "BLK-{000-999}"
      },
      {
        "name": "crop",
        "type": "category",
        "choices": ["Rice", "Wheat", "Cotton", "Chili", "Soybean"]
      },
      {
        "name": "pest_or_disease",
        "type": "category",
        "choices": [
          "Brown_Planthopper",
          "Fall_Armyworm",
          "Leaf_Blight",
          "Stem_Borer",
          "Powdery_Mildew",
          "Healthy"
        ]
      },
      {
        "name": "detection_method",
        "type": "category",
        "choices": ["drone_imagery", "edge_camera", "leaf_scanner", "iot_trap"]
      },
      {
        "name": "severity_score",
        "type": "float",
        "distribution": "uniform",
        "min": 0.0,
        "max": 1.0
      },
      {
        "name": "confidence_pct",
        "type": "float",
        "distribution": "normal",
        "mean": 82.0,
        "stddev": 12.0
      },
      {
        "name": "leaf_wetness_pct",
        "type": "float",
        "distribution": "uniform",
        "min": 0.0,
        "max": 100.0
      },
      {
        "name": "canopy_temp_c",
        "type": "float",
        "distribution": "normal",
        "mean": 29.0,
        "stddev": 3.0
      },
      {
        "name": "humidity_pct",
        "type": "float",
        "distribution": "normal",
        "mean": 70.0,
        "stddev": 9.0
      },
      {
        "name": "anomaly_probability",
        "type": "float",
        "distribution": "lognormal",
        "mean": -2.0,
        "stddev": 0.5
      },
      {
        "name": "alert_triggered",
        "type": "bool",
        "p_true": 0.22
      },
      {
        "name": "remediation_hint",
        "type": "derived_map",
        "from_field": "pest_or_disease",
        "map": {
          "Brown_Planthopper": "spray_neonicotinoid",
          "Fall_Armyworm": "pheromone_traps",
          "Leaf_Blight": "fungicide_spray",
          "Stem_Borer": "release_trichogramma",
          "Powdery_Mildew": "sulphur_dust",
          "Healthy": "no_action"
        },
        "default": "field_inspection"
      },
      {
        "name": "detection_key",
        "type": "derived_concat",
        "parts": ["farm_id", "block_id", "crop", "pest_or_disease"],
        "sep": "|"
      }
    ]
  }
}
