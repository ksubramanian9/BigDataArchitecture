{
  "seed": 606,
  "entity_count": 110000,
  "time_window": {
    "start": "2024-11-01T00:00:00",
    "end": "2025-03-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "shipment_id",
        "type": "string",
        "pattern": "SHIP-{000000-999999}"
      },
      {
        "name": "dispatch_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "3": 1.3,
            "4": 1.5,
            "5": 1.6,
            "6": 1.4,
            "_default": 0.7
          }
        }
      },
      {
        "name": "farmer_collective",
        "type": "category",
        "choices": ["Raitha_Mitra", "Uzhavar_Sangam", "Shetkari_Samiti", "Kisan_Mandali", "GreenHarvest"]
      },
      {
        "name": "origin_state",
        "type": "category",
        "choices": ["Karnataka", "Tamil Nadu", "Maharashtra", "Andhra Pradesh", "Gujarat"]
      },
      {
        "name": "origin_district",
        "type": "category",
        "conditional_on": "origin_state",
        "conditional_table": {
          "Karnataka": ["Mandya", "Ballari", "Haveri", "Belagavi"],
          "Tamil Nadu": ["Erode", "Salem", "Villupuram", "Madurai"],
          "Maharashtra": ["Satara", "Nashik", "Wardha", "Akola"],
          "Andhra Pradesh": ["Guntur", "Prakasam", "Chittoor", "Anantapur"],
          "Gujarat": ["Banaskantha", "Surat", "Rajkot", "Anand"],
          "_default": ["OriginDistrict"]
        }
      },
      {
        "name": "destination_market",
        "type": "category",
        "choices": ["Bengaluru_APMC", "Chennai_Koyambedu", "Mumbai_Vashi", "Delhi_Azadpur", "Hyderabad_Bowenpally"]
      },
      {
        "name": "transport_mode",
        "type": "category",
        "choices": ["refrigerated_truck", "open_truck", "rail", "light_cv"]
      },
      {
        "name": "distance_km",
        "type": "float",
        "distribution": "normal",
        "mean": 420.0,
        "stddev": 160.0
      },
      {
        "name": "transit_hours",
        "type": "int",
        "min": 6,
        "max": 72,
        "skew": 1.1
      },
      {
        "name": "delay_hours",
        "type": "int",
        "min": 0,
        "max": 36,
        "skew": 1.5
      },
      {
        "name": "load_tonnes",
        "type": "float",
        "distribution": "normal",
        "mean": 12.5,
        "stddev": 3.0
      },
      {
        "name": "value_inr_lakhs",
        "type": "float",
        "distribution": "normal",
        "mean": 4.8,
        "stddev": 1.4
      },
      {
        "name": "temperature_c_mean",
        "type": "float",
        "distribution": "normal",
        "mean": 6.5,
        "stddev": 4.0
      },
      {
        "name": "spoilage_pct",
        "type": "float",
        "distribution": "uniform",
        "min": 0.0,
        "max": 12.0
      },
      {
        "name": "compliance_flag",
        "type": "bool",
        "p_true": 0.9
      },
      {
        "name": "cold_chain_required",
        "type": "bool",
        "p_true": 0.45
      },
      {
        "name": "shipment_key",
        "type": "derived_concat",
        "parts": ["shipment_id", "destination_market", "transport_mode"],
        "sep": "|"
      }
    ]
  }
}
