{
  "seed": 585,
  "entity_count": 150000,
  "time_window": {
    "start": "2025-01-15T04:30:00",
    "end": "2025-05-31T23:00:00"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "irrigation_event_id",
        "type": "uuid"
      },
      {
        "name": "event_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "4": 1.4,
            "5": 1.6,
            "6": 1.7,
            "18": 1.2,
            "_default": 0.8
          },
          "day_of_week": {
            "6": 0.75,
            "0": 0.85,
            "_default": 1.0
          }
        }
      },
      {
        "name": "farm_id",
        "type": "string",
        "pattern": "FARM-{0000-9999}"
      },
      {
        "name": "irrigation_block",
        "type": "string",
        "pattern": "IRB-{000-999}"
      },
      {
        "name": "crop",
        "type": "category",
        "choices": ["Rice", "Wheat", "Groundnut", "Sugarcane", "Vegetables"]
      },
      {
        "name": "irrigation_method",
        "type": "category",
        "choices": ["drip", "sprinkler", "flood", "pivot"]
      },
      {
        "name": "soil_moisture_before_pct",
        "type": "float",
        "distribution": "uniform",
        "min": 5.0,
        "max": 45.0
      },
      {
        "name": "soil_moisture_after_pct",
        "type": "float",
        "distribution": "uniform",
        "min": 20.0,
        "max": 60.0
      },
      {
        "name": "evapotranspiration_mm",
        "type": "float",
        "distribution": "normal",
        "mean": 4.2,
        "stddev": 1.5
      },
      {
        "name": "irrigation_minutes",
        "type": "int",
        "min": 15,
        "max": 180,
        "skew": 1.2
      },
      {
        "name": "water_volume_litres",
        "type": "float",
        "distribution": "normal",
        "mean": 1850.0,
        "stddev": 420.0
      },
      {
        "name": "forecast_rain_probability",
        "type": "float",
        "distribution": "uniform",
        "min": 0.0,
        "max": 1.0
      },
      {
        "name": "recommended_delay_hours",
        "type": "int",
        "min": 0,
        "max": 48,
        "skew": 1.3
      },
      {
        "name": "pump_energy_kwh",
        "type": "float",
        "distribution": "normal",
        "mean": 9.0,
        "stddev": 2.2
      },
      {
        "name": "automation_override",
        "type": "bool",
        "p_true": 0.18
      },
      {
        "name": "event_key",
        "type": "derived_concat",
        "parts": ["farm_id", "irrigation_block", "crop"],
        "sep": "|"
      }
    ]
  }
}
