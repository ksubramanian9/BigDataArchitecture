{
  "seed": 431,
  "entity_count": 180000,
  "time_window": {
    "start": "2024-06-01T00:00:00",
    "end": "2024-12-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "record_id",
        "type": "uuid"
      },
      {
        "name": "observation_date",
        "type": "datetime",
        "format": "%Y-%m-%d"
      },
      {
        "name": "state",
        "type": "category",
        "choices": [
          { "value": "Karnataka", "weight": 3 },
          { "value": "Tamil Nadu", "weight": 2 },
          { "value": "Maharashtra", "weight": 2 },
          { "value": "Punjab", "weight": 2 },
          { "value": "Telangana", "weight": 1 }
        ]
      },
      {
        "name": "district",
        "type": "category",
        "conditional_on": "state",
        "conditional_table": {
          "Karnataka": ["Mandya", "Mysuru", "Raichur", "Belagavi"],
          "Tamil Nadu": ["Thanjavur", "Erode", "Coimbatore", "Villupuram"],
          "Maharashtra": ["Nashik", "Nagpur", "Kolhapur", "Aurangabad"],
          "Punjab": ["Ludhiana", "Sangrur", "Amritsar", "Firozpur"],
          "Telangana": ["Nalgonda", "Karimnagar", "Nizamabad", "Warangal"],
          "_default": ["DemoDistrict"]
        }
      },
      {
        "name": "farm_id",
        "type": "string",
        "pattern": "FARM-{0000-9999}"
      },
      {
        "name": "agro_climatic_zone",
        "type": "derived_map",
        "from_field": "state",
        "map": {
          "Karnataka": "Southern Plateau",
          "Tamil Nadu": "Eastern Coastal",
          "Maharashtra": "Central Plateau",
          "Punjab": "Trans-Gangetic",
          "Telangana": "Deccan Plateau"
        },
        "default": "Unknown"
      },
      {
        "name": "crop",
        "type": "category",
        "choices": [
          { "value": "Rice", "weight": 3 },
          { "value": "Wheat", "weight": 2 },
          { "value": "Maize", "weight": 2 },
          { "value": "Sugarcane", "weight": 1 },
          { "value": "Millet", "weight": 1 }
        ]
      },
      {
        "name": "sowing_week",
        "type": "int",
        "min": 22,
        "max": 32,
        "skew": 1.1
      },
      {
        "name": "harvest_week",
        "type": "int",
        "min": 40,
        "max": 52,
        "skew": 1.2
      },
      {
        "name": "soil_moisture_pct",
        "type": "float",
        "distribution": "uniform",
        "min": 8.0,
        "max": 48.0
      },
      {
        "name": "soil_ph",
        "type": "float",
        "distribution": "normal",
        "mean": 6.6,
        "stddev": 0.4
      },
      {
        "name": "rainfall_mm",
        "type": "float",
        "distribution": "exponential",
        "lambda": 0.045
      },
      {
        "name": "avg_temp_c",
        "type": "float",
        "distribution": "normal",
        "mean": 28.5,
        "stddev": 3.5
      },
      {
        "name": "humidity_pct",
        "type": "float",
        "distribution": "normal",
        "mean": 68.0,
        "stddev": 8.0
      },
      {
        "name": "ndvi_index",
        "type": "float",
        "distribution": "normal",
        "mean": 0.58,
        "stddev": 0.12
      },
      {
        "name": "fertilizer_kg_per_ha",
        "type": "float",
        "distribution": "normal",
        "mean": 140.0,
        "stddev": 25.0
      },
      {
        "name": "irrigation_events",
        "type": "int",
        "min": 0,
        "max": 12,
        "skew": 1.4
      },
      {
        "name": "yield_kg_per_ha",
        "type": "float",
        "distribution": "normal",
        "mean": 5200.0,
        "stddev": 900.0
      },
      {
        "name": "yield_flag_low",
        "type": "bool",
        "p_true": 0.12
      },
      {
        "name": "record_key",
        "type": "derived_concat",
        "parts": ["state", "district", "farm_id", "crop"],
        "sep": "|"
      }
    ]
  }
}
