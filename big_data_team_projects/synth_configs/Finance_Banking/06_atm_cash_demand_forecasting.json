{
  "seed": 48,
  "entity_count": 90000,
  "time_window": {
    "start": "2025-01-01T00:00:00",
    "end": "2025-04-30T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "snapshot_id",
        "type": "uuid"
      },
      {
        "name": "snapshot_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "0": 0.4,
            "6": 1.1,
            "12": 1.3,
            "18": 1.2,
            "21": 1.1,
            "_default": 0.9
          },
          "day_of_week": {
            "5": 1.3,
            "6": 1.4,
            "_default": 1.0
          }
        }
      },
      {
        "name": "atm_id",
        "type": "string",
        "pattern": "ATM-{0000-9999}"
      },
      {
        "name": "branch_city",
        "type": "category",
        "choices": [
          { "value": "Bengaluru", "weight": 3 },
          { "value": "Chennai", "weight": 2 },
          { "value": "Mumbai", "weight": 2 },
          { "value": "Delhi", "weight": 2 },
          { "value": "Hyderabad", "weight": 1 },
          { "value": "Pune", "weight": 1 }
        ]
      },
      {
        "name": "location_type",
        "type": "category",
        "choices": [
          { "value": "Mall", "weight": 2 },
          { "value": "High_Street", "weight": 3 },
          { "value": "Transit_Hub", "weight": 1.5 },
          { "value": "Residential", "weight": 2 },
          { "value": "Corporate_Park", "weight": 1.5 }
        ]
      },
      {
        "name": "installed_cash_capacity_inr",
        "type": "float",
        "distribution": "lognormal",
        "mean": 12.5,
        "stddev": 0.35
      },
      {
        "name": "cash_level_start_of_day_inr",
        "type": "float",
        "distribution": "lognormal",
        "mean": 12.0,
        "stddev": 0.4
      },
      {
        "name": "withdrawal_count_last_hour",
        "type": "int",
        "min": 0,
        "max": 180,
        "skew": 0.7
      },
      {
        "name": "withdrawal_amount_last_hour_inr",
        "type": "float",
        "distribution": "lognormal",
        "mean": 9.5,
        "stddev": 0.6
      },
      {
        "name": "cumulative_withdrawal_amount_today_inr",
        "type": "float",
        "distribution": "lognormal",
        "mean": 11.0,
        "stddev": 0.5
      },
      {
        "name": "replenishment_due_in_hours",
        "type": "int",
        "min": 0,
        "max": 72,
        "skew": 0.5
      },
      {
        "name": "is_weekend",
        "type": "bool",
        "p_true": 0.3
      },
      {
        "name": "is_bank_holiday",
        "type": "bool",
        "p_true": 0.08
      },
      {
        "name": "nearby_event_footfall_index",
        "type": "float",
        "distribution": "normal",
        "mean": 0.2,
        "stddev": 0.25
      },
      {
        "name": "weather_condition",
        "type": "category",
        "choices": [
          { "value": "Clear", "weight": 4 },
          { "value": "Cloudy", "weight": 3 },
          { "value": "Rain", "weight": 2 },
          { "value": "Storm", "weight": 0.5 },
          { "value": "Heatwave", "weight": 0.5 }
        ]
      },
      {
        "name": "forecast_cash_withdrawal_next_8h_inr",
        "type": "float",
        "distribution": "lognormal",
        "mean": 10.8,
        "stddev": 0.45
      },
      {
        "name": "stockout_risk_level",
        "type": "category",
        "choices": [
          { "value": "Low", "weight": 5 },
          { "value": "Medium", "weight": 3 },
          { "value": "High", "weight": 2 }
        ]
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "atm_id",
          "branch_city",
          "snapshot_time"
        ],
        "sep": "|"
      }
    ]
  }
}
