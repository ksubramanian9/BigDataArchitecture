{
  "seed": 47,
  "entity_count": 150000,
  "time_window": {
    "start": "2024-11-01T00:00:00",
    "end": "2025-03-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "record_id",
        "type": "uuid"
      },
      {
        "name": "as_of_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "9": 1.4,
            "10": 1.4,
            "15": 1.2,
            "_default": 0.9
          },
          "day_of_week": {
            "0": 0.2,
            "6": 0.2,
            "_default": 1.0
          }
        }
      },
      {
        "name": "ticker",
        "type": "category",
        "choices": [
          { "value": "NSE:HDFCBANK", "weight": 3 },
          { "value": "NSE:INFY", "weight": 2 },
          { "value": "NSE:ICICIBANK", "weight": 2 },
          { "value": "NSE:RELIANCE", "weight": 2 },
          { "value": "NSE:TCS", "weight": 2 },
          { "value": "NSE:SBIN", "weight": 1 }
        ]
      },
      {
        "name": "market_sector",
        "type": "category",
        "choices": [
          "Banking",
          "IT_Services",
          "Energy",
          "Consumer",
          "Industrial"
        ]
      },
      {
        "name": "sentiment_score",
        "type": "float",
        "distribution": "normal",
        "mean": 0.05,
        "stddev": 0.4
      },
      {
        "name": "news_volume",
        "type": "int",
        "min": 0,
        "max": 250,
        "skew": 0.6
      },
      {
        "name": "social_buzz_score",
        "type": "float",
        "distribution": "normal",
        "mean": 0.5,
        "stddev": 0.25
      },
      {
        "name": "price_open",
        "type": "float",
        "distribution": "lognormal",
        "mean": 3.9,
        "stddev": 0.4
      },
      {
        "name": "price_close",
        "type": "float",
        "distribution": "lognormal",
        "mean": 3.9,
        "stddev": 0.4
      },
      {
        "name": "price_high",
        "type": "float",
        "distribution": "lognormal",
        "mean": 4.0,
        "stddev": 0.38
      },
      {
        "name": "price_low",
        "type": "float",
        "distribution": "lognormal",
        "mean": 3.8,
        "stddev": 0.38
      },
      {
        "name": "traded_volume_shares",
        "type": "int",
        "min": 5000,
        "max": 5000000,
        "skew": 0.8
      },
      {
        "name": "implied_volatility_30d",
        "type": "float",
        "distribution": "normal",
        "mean": 0.28,
        "stddev": 0.06
      },
      {
        "name": "price_movement_pct",
        "type": "float",
        "distribution": "normal",
        "mean": 0.01,
        "stddev": 0.05
      },
      {
        "name": "movement_direction",
        "type": "category",
        "choices": [
          { "value": "Up", "weight": 4 },
          { "value": "Down", "weight": 3 },
          { "value": "Flat", "weight": 3 }
        ]
      },
      {
        "name": "headline_impact_class",
        "type": "category",
        "choices": [
          { "value": "High", "weight": 2 },
          { "value": "Medium", "weight": 5 },
          { "value": "Low", "weight": 3 }
        ]
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "ticker",
          "market_sector",
          "movement_direction"
        ],
        "sep": "|"
      }
    ]
  }
}
