        "name": "recommendation_event_id",
        "type": "uuid"
      },
      {
        "name": "event_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "8": 1.5,
            "9": 1.5,
            "18": 1.5,
            "19": 1.5,
            "_default": 1.0
          },
          "day_of_week": {
            "5": 0.8,
            "6": 0.7,
            "_default": 1.0
          }
        }
      },
      {
        "name": "student_id",
        "type": "string",
        "pattern": "STU{000000-999999}"
      },
      {
        "name": "course_id",
        "type": "string",
        "pattern": "COURSE{000-999}"
      },
      {
        "name": "module_id",
        "type": "string",
        "pattern": "MOD{000-999}"
      },
      {
        "name": "current_mastery_score",
