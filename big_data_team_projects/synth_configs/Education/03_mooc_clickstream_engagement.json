{
  "seed": 45,
  "entity_count": 250000,
  "time_window": {
    "start": "2025-01-01T06:00:00",
    "end": "2025-03-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "clickstream_event_id",
        "type": "uuid"
      },
      {
        "name": "event_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "6": 1.2,
            "7": 1.3,
            "8": 1.5,
            "18": 1.4,
            "19": 1.3,
            "_default": 1.0
          },
          "day_of_week": {
            "5": 1.1,
            "6": 0.9,
            "_default": 1.0
          }
        }
      },
      {
        "name": "student_id",
        "type": "string",
        "pattern": "STU{000000-999999}"
      },
      {
        "name": "course_id",
        "type": "string",
        "pattern": "MOOC{000-999}"
      },
      {
        "name": "session_id",
        "type": "string",
        "pattern": "SESS{0000000-9999999}"
      },
      {
        "name": "page_path",
        "type": "category",
        "choices": [
          {
            "value": "/course/overview",
            "weight": 2
          },
          {
            "value": "/course/module/introduction",
            "weight": 3
          },
          {
            "value": "/course/module/video",
            "weight": 4
          },
          {
            "value": "/course/module/quiz",
            "weight": 3
          },
          {
            "value": "/course/discussion/thread",
            "weight": 2
          },
          {
            "value": "/course/resources/download",
            "weight": 1
          }
        ]
      },
      {
        "name": "page_category",
        "type": "category",
        "choices": [
          {
            "value": "overview",
            "weight": 1
          },
          {
            "value": "video",
            "weight": 4
          },
          {
            "value": "quiz",
            "weight": 2
          },
          {
            "value": "forum",
            "weight": 2
          },
          {
            "value": "resource",
            "weight": 1
          }
        ]
      },
      {
        "name": "interaction_type",
        "type": "category",
        "choices": [
          {
            "value": "page_view",
            "weight": 5
          },
          {
            "value": "video_play",
            "weight": 4
          },
          {
            "value": "quiz_attempt",
            "weight": 2
          },
          {
            "value": "forum_post",
            "weight": 1
          },
          {
            "value": "resource_download",
            "weight": 1
          }
        ]
      },
      {
        "name": "dwell_time_seconds",
        "type": "float",
        "distribution": "lognormal",
        "mean": 4.5,
        "stddev": 0.7
      },
      {
        "name": "scroll_depth_percent",
        "type": "float",
        "distribution": "normal",
        "mean": 62.0,
        "stddev": 18.0,
        "min": 0.0,
        "max": 100.0
      },
      {
        "name": "video_position_percent",
        "type": "float",
        "distribution": "normal",
        "mean": 55.0,
        "stddev": 25.0,
        "min": 0.0,
        "max": 100.0
      },
      {
        "name": "device_type",
        "type": "category",
        "choices": [
          {
            "value": "desktop",
            "weight": 4
          },
          {
            "value": "mobile",
            "weight": 3
          },
          {
            "value": "tablet",
            "weight": 1
          }
        ]
      },
      {
        "name": "browser_family",
        "type": "category",
        "choices": [
          {
            "value": "chrome",
            "weight": 5
          },
          {
            "value": "firefox",
            "weight": 2
          },
          {
            "value": "safari",
            "weight": 2
          },
          {
            "value": "edge",
            "weight": 1
          }
        ]
      },
      {
        "name": "referral_source",
        "type": "category",
        "choices": [
          {
            "value": "direct",
            "weight": 4
          },
          {
            "value": "email",
            "weight": 2
          },
          {
            "value": "social",
            "weight": 2
          },
          {
            "value": "search",
            "weight": 3
          },
          {
            "value": "external_lms",
            "weight": 1
          }
        ]
      },
      {
        "name": "geo_region",
        "type": "category",
        "choices": [
          {
            "value": "APAC",
            "weight": 3
          },
          {
            "value": "EMEA",
            "weight": 2
          },
          {
            "value": "AMER",
            "weight": 2
          }
        ]
      },
      {
        "name": "is_first_visit",
        "type": "bool",
        "p_true": 0.22
      },
      {
        "name": "participation_score",
        "type": "float",
        "distribution": "normal",
        "mean": 0.54,
        "stddev": 0.2,
        "min": 0.0,
        "max": 1.0
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "student_id",
          "course_id",
          "session_id"
        ],
        "sep": "|"
      }
    ]
  }
}
