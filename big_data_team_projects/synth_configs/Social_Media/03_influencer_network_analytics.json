{
  "seed": 45,
  "entity_count": 200000,
  "time_window": {
    "start": "2025-01-01T06:00:00",
    "end": "2025-02-28T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "snapshot_id",
        "type": "uuid"
      },
      {
        "name": "snapshot_time",
        "type": "datetime",
        "format": "iso"
      },
      {
        "name": "influencer_id",
        "type": "string",
        "pattern": "INF{000000-999999}"
      },
      {
        "name": "platform",
        "type": "category",
        "choices": [
          { "value": "instagram", "weight": 4 },
          { "value": "youtube", "weight": 3 },
          { "value": "tiktok", "weight": 2 },
          { "value": "twitter", "weight": 1 }
        ]
      },
      {
        "name": "primary_city",
        "type": "category",
        "choices": [
          { "value": "Bengaluru", "weight": 3 },
          { "value": "Mumbai", "weight": 3 },
          { "value": "Delhi", "weight": 2 },
          { "value": "Hyderabad", "weight": 1 },
          { "value": "Chennai", "weight": 1 }
        ]
      },
      {
        "name": "follower_count",
        "type": "int",
        "min": 5000,
        "max": 25000000,
        "skew": 0.85
      },
      {
        "name": "follower_growth_7d",
        "type": "int",
        "min": -2000,
        "max": 50000,
        "skew": 0.4
      },
      {
        "name": "avg_engagement_rate",
        "type": "float",
        "distribution": "normal",
        "mean": 0.042,
        "stddev": 0.015
      },
      {
        "name": "true_reach_estimate",
        "type": "int",
        "min": 2000,
        "max": 15000000,
        "skew": 0.8
      },
      {
        "name": "network_centrality_score",
        "type": "float",
        "distribution": "normal",
        "mean": 0.58,
        "stddev": 0.2
      },
      {
        "name": "collaboration_count_30d",
        "type": "int",
        "min": 0,
        "max": 50,
        "skew": 0.6
      },
      {
        "name": "audience_overlap_cluster",
        "type": "string",
        "pattern": "AOC{000-999}"
      },
      {
        "name": "sponsored_content_ratio",
        "type": "float",
        "distribution": "normal",
        "mean": 0.22,
        "stddev": 0.12
      },
      {
        "name": "top_content_format",
        "type": "category",
        "choices": [
          { "value": "short_video", "weight": 3 },
          { "value": "photo", "weight": 2 },
          { "value": "live_stream", "weight": 1.5 },
          { "value": "long_form_video", "weight": 1.5 },
          { "value": "text_post", "weight": 1 }
        ]
      },
      {
        "name": "authenticity_score",
        "type": "float",
        "distribution": "normal",
        "mean": 0.74,
        "stddev": 0.1
      },
      {
        "name": "is_verified",
        "type": "bool",
        "p_true": 0.32
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "influencer_id",
          "platform",
          "audience_overlap_cluster"
        ],
        "sep": "|"
      }
    ]
  }
}