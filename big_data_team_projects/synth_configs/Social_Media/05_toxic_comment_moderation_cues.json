{
  "seed": 47,
  "entity_count": 200000,
  "time_window": {
    "start": "2025-01-01T06:00:00",
    "end": "2025-02-28T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "comment_id",
        "type": "uuid"
      },
      {
        "name": "comment_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "0": 0.7,
            "1": 0.6,
            "22": 1.3,
            "23": 1.4,
            "_default": 1.0
          },
          "day_of_week": {
            "6": 1.2,
            "0": 1.1,
            "_default": 1.0
          }
        }
      },
      {
        "name": "user_id",
        "type": "string",
        "pattern": "U{000000-999999}"
      },
      {
        "name": "community_id",
        "type": "string",
        "pattern": "COMM{0000-9999}"
      },
      {
        "name": "thread_id",
        "type": "string",
        "pattern": "THR{000000-999999}"
      },
      {
        "name": "language",
        "type": "category",
        "choices": [
          { "value": "en", "weight": 6 },
          { "value": "hi", "weight": 3 },
          { "value": "es", "weight": 1 },
          { "value": "ta", "weight": 1 },
          { "value": "ar", "weight": 0.5 }
        ]
      },
      {
        "name": "comment_length_chars",
        "type": "int",
        "min": 3,
        "max": 2000,
        "skew": 0.6
      },
      {
        "name": "toxicity_score",
        "type": "float",
        "distribution": "normal",
        "mean": 0.35,
        "stddev": 0.22
      },
      {
        "name": "toxicity_label",
        "type": "category",
        "choices": [
          { "value": "clean", "weight": 6 },
          { "value": "borderline", "weight": 2 },
          { "value": "toxic", "weight": 2 }
        ]
      },
      {
        "name": "severe_toxicity_probability",
        "type": "float",
        "distribution": "normal",
        "mean": 0.18,
        "stddev": 0.15
      },
      {
        "name": "hate_speech_probability",
        "type": "float",
        "distribution": "normal",
        "mean": 0.12,
        "stddev": 0.14
      },
      {
        "name": "threat_probability",
        "type": "float",
        "distribution": "normal",
        "mean": 0.07,
        "stddev": 0.1
      },
      {
        "name": "profanity_density",
        "type": "float",
        "distribution": "normal",
        "mean": 0.2,
        "stddev": 0.18
      },
      {
        "name": "prior_reports_count",
        "type": "int",
        "min": 0,
        "max": 25,
        "skew": 0.7
      },
      {
        "name": "report_source_type",
        "type": "category",
        "choices": [
          { "value": "user_report", "weight": 4 },
          { "value": "ai_flag", "weight": 3 },
          { "value": "moderator_review", "weight": 2 },
          { "value": "legal_request", "weight": 1 }
        ]
      },
      {
        "name": "user_toxic_history_rate",
        "type": "float",
        "distribution": "normal",
        "mean": 0.12,
        "stddev": 0.1
      },
      {
        "name": "moderation_action",
        "type": "category",
        "choices": [
          { "value": "auto_hidden", "weight": 2 },
          { "value": "pending_review", "weight": 4 },
          { "value": "escalated", "weight": 1 },
          { "value": "allowed", "weight": 3 }
        ]
      },
      {
        "name": "escalation_priority",
        "type": "category",
        "choices": [
          { "value": "critical", "weight": 1.5 },
          { "value": "high", "weight": 2.5 },
          { "value": "medium", "weight": 3 },
          { "value": "low", "weight": 3 }
        ]
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "comment_id",
          "user_id",
          "moderation_action"
        ],
        "sep": "|"
      }
    ]
  }
}