{
  "seed": 23,
  "entity_count": 250000,
  "time_window": {
    "start": "2025-01-01T00:00:00",
    "end": "2025-01-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "reading_id",
        "type": "uuid"
      },
      {
        "name": "patient_id",
        "type": "string",
        "pattern": "PT-{000000-999999}"
      },
      {
        "name": "device_id",
        "type": "string",
        "pattern": "DEV-{000000-999999}"
      },
      {
        "name": "device_type",
        "type": "category",
        "choices": [
          { "value": "Smartwatch", "weight": 3 },
          { "value": "Chest_Patch", "weight": 1.2 },
          { "value": "Smart_Ring", "weight": 0.8 },
          { "value": "Blood_Pressure_Cuff", "weight": 1.0 }
        ]
      },
      {
        "name": "sensor_stream",
        "type": "category",
        "choices": [
          "Vitals",
          "Activity",
          "Sleep",
          "Cardiac",
          "Respiratory"
        ]
      },
      {
        "name": "reading_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "0": 0.7,
            "1": 0.6,
            "5": 0.9,
            "6": 1.1,
            "7": 1.2,
            "8": 1.3,
            "18": 1.4,
            "19": 1.3,
            "_default": 1.0
          }
        }
      },
      {
        "name": "sampling_interval_seconds",
        "type": "int",
        "min": 5,
        "max": 900,
        "skew": 1.2
      },
      {
        "name": "heart_rate_bpm",
        "type": "float",
        "distribution": "normal",
        "mean": 76,
        "stddev": 12
      },
      {
        "name": "respiration_rate",
        "type": "float",
        "distribution": "normal",
        "mean": 16,
        "stddev": 3.5
      },
      {
        "name": "skin_temperature_c",
        "type": "float",
        "distribution": "normal",
        "mean": 33.5,
        "stddev": 1.1
      },
      {
        "name": "blood_pressure_systolic",
        "type": "int",
        "min": 90,
        "max": 200,
        "skew": 1.4
      },
      {
        "name": "blood_pressure_diastolic",
        "type": "int",
        "min": 50,
        "max": 130,
        "skew": 1.3
      },
      {
        "name": "spo2",
        "type": "float",
        "distribution": "normal",
        "mean": 97.5,
        "stddev": 1.5
      },
      {
        "name": "step_count_interval",
        "type": "int",
        "min": 0,
        "max": 6000,
        "skew": 1.05
      },
      {
        "name": "calories_burned_interval",
        "type": "float",
        "distribution": "normal",
        "mean": 35,
        "stddev": 18
      },
      {
        "name": "sleep_stage",
        "type": "category",
        "choices": [
          "Awake",
          "Light",
          "Deep",
          "REM"
        ]
      },
      {
        "name": "sleep_duration_minutes",
        "type": "int",
        "min": 0,
        "max": 720,
        "skew": 1.1
      },
      {
        "name": "activity_level",
        "type": "category",
        "choices": [
          { "value": "Sedentary", "weight": 1.8 },
          { "value": "Light", "weight": 2.5 },
          { "value": "Moderate", "weight": 1.5 },
          { "value": "Vigorous", "weight": 0.6 }
        ]
      },
      {
        "name": "battery_level_percent",
        "type": "int",
        "min": 1,
        "max": 100,
        "skew": 0.9
      },
      {
        "name": "signal_quality_score",
        "type": "float",
        "distribution": "normal",
        "mean": 0.82,
        "stddev": 0.1
      },
      {
        "name": "alert_triggered",
        "type": "bool",
        "p_true": 0.08
      },
      {
        "name": "data_latency_seconds",
        "type": "int",
        "min": 0,
        "max": 120,
        "skew": 1.3
      },
      {
        "name": "firmware_version",
        "type": "string",
        "pattern": "v{1-4}.{0-9}.{0-9}"
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "device_id",
          "reading_time"
        ],
        "sep": "|"
      }
    ]
  }
}
