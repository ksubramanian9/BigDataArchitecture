{
  "seed": 59,
  "entity_count": 90000,
  "time_window": {
    "start": "2024-06-01T00:00:00",
    "end": "2025-05-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "study_uid",
        "type": "string",
        "pattern": "1.2.840.{000000000000-999999999999}"
      },
      {
        "name": "accession_number",
        "type": "string",
        "pattern": "ACC-{000000-999999}"
      },
      {
        "name": "patient_id",
        "type": "string",
        "pattern": "MRN-{0000000-9999999}"
      },
      {
        "name": "study_datetime",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "6": 0.6,
            "7": 0.9,
            "8": 1.4,
            "9": 1.6,
            "10": 1.5,
            "20": 0.7,
            "_default": 0.9
          },
          "day_of_week": {
            "5": 0.85,
            "6": 0.65,
            "_default": 1.0
          }
        }
      },
      {
        "name": "modality",
        "type": "category",
        "choices": [
          { "value": "CT", "weight": 2.2 },
          { "value": "MR", "weight": 1.6 },
          { "value": "XR", "weight": 2.8 },
          { "value": "US", "weight": 1.2 },
          { "value": "PET", "weight": 0.4 }
        ]
      },
      {
        "name": "body_region",
        "type": "category",
        "choices": [
          "Head",
          "Chest",
          "Abdomen",
          "Pelvis",
          "Extremity",
          "Spine"
        ]
      },
      {
        "name": "procedure_code",
        "type": "category",
        "choices": [
          "IMG_CT_HEAD_WO",
          "IMG_MR_BRAIN_WW",
          "IMG_XR_CHEST_PA",
          "IMG_US_ABD_COMP",
          "IMG_CT_CHEST_WW"
        ]
      },
      {
        "name": "image_count",
        "type": "int",
        "min": 1,
        "max": 2000,
        "skew": 1.25
      },
      {
        "name": "avg_slice_thickness_mm",
        "type": "float",
        "distribution": "normal",
        "mean": 3.5,
        "stddev": 1.8
      },
      {
        "name": "pixel_spacing_mm",
        "type": "float",
        "distribution": "normal",
        "mean": 0.85,
        "stddev": 0.25
      },
      {
        "name": "image_resolution",
        "type": "category",
        "choices": [
          "512x512",
          "1024x1024",
          "2048x2048",
          "4096x4096"
        ]
      },
      {
        "name": "study_duration_seconds",
        "type": "int",
        "min": 60,
        "max": 5400,
        "skew": 1.1
      },
      {
        "name": "file_size_mb",
        "type": "float",
        "distribution": "lognormal",
        "mean": 4.2,
        "stddev": 0.8
      },
      {
        "name": "contrast_used",
        "type": "bool",
        "p_true": 0.32
      },
      {
        "name": "ai_pre_read_flag",
        "type": "bool",
        "p_true": 0.22
      },
      {
        "name": "radiologist_id",
        "type": "string",
        "pattern": "RAD-{000-999}"
      },
      {
        "name": "report_turnaround_hours",
        "type": "float",
        "distribution": "normal",
        "mean": 7.5,
        "stddev": 2.5
      },
      {
        "name": "follow_up_recommended",
        "type": "bool",
        "p_true": 0.27
      },
      {
        "name": "annotation_status",
        "type": "category",
        "choices": [
          { "value": "Not_Annotated", "weight": 2.5 },
          { "value": "In_Progress", "weight": 1.0 },
          { "value": "Completed", "weight": 1.5 }
        ]
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "study_uid",
          "modality"
        ],
        "sep": "|"
      }
    ]
  }
}
