{
  "seed": 43,
  "entity_count": 200000,
  "time_window": {
    "start": "2024-01-01T00:00:00",
    "end": "2025-01-31T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "encounter_id",
        "type": "uuid"
      },
      {
        "name": "patient_id",
        "type": "string",
        "pattern": "PT-{000000-999999}"
      },
      {
        "name": "event_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "7": 1.2,
            "8": 1.4,
            "9": 1.4,
            "18": 1.3,
            "19": 1.2,
            "_default": 0.9
          },
          "day_of_week": {
            "0": 0.7,
            "5": 0.8,
            "6": 0.75,
            "_default": 1.0
          }
        }
      },
      {
        "name": "facility_city",
        "type": "category",
        "choices": [
          { "value": "Bengaluru", "weight": 3 },
          { "value": "Chennai", "weight": 2 },
          { "value": "Mumbai", "weight": 2 },
          { "value": "Delhi", "weight": 2 },
          { "value": "Hyderabad", "weight": 1 }
        ]
      },
      {
        "name": "hospital",
        "type": "category",
        "choices": [
          "Govt_GH",
          "City_Med",
          "Metro_Care",
          "AIIMS_Unit"
        ]
      },
      {
        "name": "department",
        "type": "category",
        "choices": [
          "Cardiology",
          "General_Medicine",
          "Endocrinology",
          "Pulmonology",
          "Nephrology",
          "ICU"
        ]
      },
      {
        "name": "primary_diagnosis_group",
        "type": "category",
        "choices": [
          "CHF",
          "COPD",
          "Diabetes",
          "Hypertension",
          "Pneumonia",
          "Renal_Failure"
        ]
      },
      {
        "name": "length_of_stay_days",
        "type": "int",
        "min": 1,
        "max": 45,
        "skew": 1.4
      },
      {
        "name": "prior_admissions_12mo",
        "type": "int",
        "min": 0,
        "max": 12,
        "skew": 1.6
      },
      {
        "name": "chronic_conditions_count",
        "type": "int",
        "min": 0,
        "max": 8,
        "skew": 1.3
      },
      {
        "name": "elixhauser_index",
        "type": "float",
        "distribution": "normal",
        "mean": 12,
        "stddev": 5
      },
      {
        "name": "discharge_disposition",
        "type": "category",
        "choices": [
          { "value": "Home", "weight": 4 },
          { "value": "Skilled_Nursing", "weight": 2 },
          { "value": "Rehab", "weight": 1 },
          { "value": "Home_Health", "weight": 2 },
          { "value": "Left_Against_Advice", "weight": 0.3 }
        ]
      },
      {
        "name": "medication_adherence_score",
        "type": "float",
        "distribution": "normal",
        "mean": 0.72,
        "stddev": 0.15
      },
      {
        "name": "follow_up_scheduled_within_7_days",
        "type": "bool",
        "p_true": 0.62
      },
      {
        "name": "post_discharge_contact_attempts",
        "type": "int",
        "min": 0,
        "max": 5,
        "skew": 1.2
      },
      {
        "name": "home_health_services",
        "type": "bool",
        "p_true": 0.25
      },
      {
        "name": "days_since_last_discharge",
        "type": "int",
        "min": 0,
        "max": 365,
        "skew": 1.1
      },
      {
        "name": "has_primary_care_provider",
        "type": "bool",
        "p_true": 0.78
      },
      {
        "name": "readmission_risk_score",
        "type": "float",
        "distribution": "normal",
        "mean": 0.38,
        "stddev": 0.18
      },
      {
        "name": "readmitted_within_30_days",
        "type": "bool",
        "p_true": 0.19
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "patient_id",
          "event_time"
        ],
        "sep": "|"
      }
    ]
  }
}
