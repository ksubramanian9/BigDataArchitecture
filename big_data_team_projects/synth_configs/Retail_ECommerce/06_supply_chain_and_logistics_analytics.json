  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "shipment_id",
        "type": "string",
        "pattern": "SHP-{000000-999999}"
      },
      {
        "name": "order_id",
        "type": "string",
        "pattern": "O{00000000-99999999}"
      },
      {
        "name": "sku",
        "type": "string",
        "pattern": "SKU-{000000-999999}"
      },
      {
        "name": "warehouse",
        "type": "category",
        "choices": [
          "BLR_FC01",
          "BLR_FC02",
          "MUM_FC01",
          "DEL_FC01",
          "HYD_FC01",
          "CHE_FC01"
        ]
      },
      {
        "name": "warehouse_geo",
        "type": "geo",
        "precision": 4,
        "bbox": [10.0, 72.5, 23.0, 88.5]
      },
      {
        "name": "carrier",
        "type": "category",
        "choices": [
          "Ekart",
          "Delhivery",
          "BlueDart",
          "EcomExpress",
          "Shadowfax"
        ]
      },
      {
        "name": "last_mile_partner",
