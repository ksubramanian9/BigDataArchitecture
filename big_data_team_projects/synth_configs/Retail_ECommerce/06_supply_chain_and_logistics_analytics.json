        "choices": [
          {
            "value": "na",
            "weight": 8
          },
          {
            "value": "compliant",
            "weight": 1
          },
          {
            "value": "deviation",
            "weight": 1
          }
        ]
      },
      {
        "name": "transport_mode",
        "type": "category",
        "choices": [
          {
            "value": "road",
            "weight": 6
          },
          {
            "value": "air",
