        "choices": [
          "InHouse",
          "Shadowfax",
          "Dunzo",
          "Loadshare"
        ]
      },
      {
        "name": "route_type",
        "type": "category",
        "choices": [
          "metro_same_state",
          "metro_cross_state",
          "tier2_direct",
          "tier3_hub_spoke"
        ]
      },
      {
        "name": "promised_ship_date",
        "type": "datetime",
        "format": "iso",
        "mode": "uniform"
      },
      {
        "name": "actual_ship_date",
        "type": "datetime",
        "format": "iso",
        "mode": "uniform"
      },
      {
        "name": "promised_delivery_date",
        "type": "datetime",
        "format": "iso",
        "mode": "uniform"
      },
      {
        "name": "actual_delivery_date",
        "type": "datetime",
        "format": "iso",
        "mode": "uniform"
      },
      {
        "name": "transit_hours",
        "type": "int",
        "min": 4,
        "max": 240,
        "skew": 1.2
      },
      {
        "name": "delay_hours",
        "type": "int",
        "min": -24,
        "max": 96,
        "skew": 1.4
      },
      {
