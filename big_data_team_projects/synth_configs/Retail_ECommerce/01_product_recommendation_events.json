{
  "seed": 43,
  "entity_count": 200000,
  "time_window": {
    "start": "2025-01-01T06:00:00",
    "end": "2025-02-28T23:59:59"
  },
  "output": {
    "format": "csv"
  },
  "schema": {
    "fields": [
      {
        "name": "event_id",
        "type": "uuid"
      },
      {
        "name": "event_time",
        "type": "datetime",
        "format": "iso",
        "mode": "seasonality",
        "profile": {
          "hour_of_day": {
            "8": 1.6,
            "9": 1.4,
            "12": 1.2,
            "18": 1.6,
            "19": 1.6,
            "21": 1.3,
            "_default": 1.0
          },
          "day_of_week": {
            "5": 1.2,
            "6": 1.3,
            "0": 1.1,
            "_default": 1.0
          }
        }
      },
      {
        "name": "session_id",
        "type": "string",
        "pattern": "S{00000000-99999999}"
      },
      {
        "name": "user_id",
        "type": "string",
        "pattern": "U{000000-999999}"
      },
      {
        "name": "is_prime_member",
        "type": "bool",
        "p_true": 0.35
      },
      {
        "name": "city",
        "type": "category",
        "choices": [
          {
            "value": "Bengaluru",
            "weight": 3
          },
          {
            "value": "Chennai",
            "weight": 2
          },
          {
            "value": "Mumbai",
            "weight": 2
          },
          {
            "value": "Delhi",
            "weight": 2
          },
          {
            "value": "Hyderabad",
            "weight": 1
          }
        ]
      },
      {
        "name": "device_type",
        "type": "category",
        "choices": [
          {
            "value": "mobile_app",
            "weight": 5
          },
          {
            "value": "mobile_web",
            "weight": 2
          },
          {
            "value": "desktop_web",
            "weight": 3
          }
        ]
      },
      {
        "name": "traffic_source",
        "type": "category",
        "choices": [
          {
            "value": "organic",
            "weight": 4
          },
          {
            "value": "email_campaign",
            "weight": 2
          },
          {
            "value": "push_notification",
            "weight": 1
          },
          {
            "value": "paid_social",
            "weight": 1
          },
          {
            "value": "affiliate",
            "weight": 1
          }
        ]
      },
      {
        "name": "event_type",
        "type": "category",
        "choices": [
          {
            "value": "view",
            "weight": 6
          },
          {
            "value": "add_to_cart",
            "weight": 2
          },
          {
            "value": "purchase",
            "weight": 1
          },
          {
            "value": "wishlist",
            "weight": 1
          }
        ]
      },
      {
        "name": "product_id",
        "type": "string",
        "pattern": "P{000000-999999}"
      },
      {
        "name": "product_category",
        "type": "category",
        "choices": [
          "Fashion",
          "Grocery",
          "Electronics",
          "Home",
          "Beauty",
          "Books"
        ]
      },
      {
        "name": "recommendation_algorithm",
        "type": "category",
        "choices": [
          "collaborative_filtering",
          "content_based",
          "trending_now",
          "new_arrivals"
        ]
      },
      {
        "name": "recommendation_rank",
        "type": "int",
        "min": 1,
        "max": 20,
        "skew": 1.2
      },
      {
        "name": "personalization_score",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "precision": 3
      },
      {
        "name": "price",
        "type": "float",
        "distribution": "lognormal",
        "mean": 0.0,
        "stddev": 1.0
      },
      {
        "name": "discount_pct",
