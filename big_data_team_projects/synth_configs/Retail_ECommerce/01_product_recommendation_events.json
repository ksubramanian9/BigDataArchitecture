        "min": 1,
        "max": 5,
        "skew": 1.5
      },
      {
        "name": "position_in_carousel",
        "type": "int",
        "min": 1,
        "max": 10,
        "skew": 1.1
      },
      {
        "name": "experiment_bucket",
        "type": "category",
        "choices": [
          {
            "value": "control",
            "weight": 1
          },
          {
            "value": "variant_a",
            "weight": 1
          },
          {
            "value": "variant_b",
            "weight": 1
          }
        ]
      },
      {
        "name": "key",
        "type": "derived_concat",
        "parts": [
          "user_id",
          "product_id",
          "session_id"
        ],
        "sep": "|"
      }
    ]
  }
